# Supabase Configuration
# Get these from your Supabase project dashboard
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenAI Configuration
# Get this from your OpenAI account
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom prompt for schedule extraction
# If not set, a default prompt will be used
SCHEDULE_EXTRACTION_PROMPT=your_custom_prompt_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Development Configuration
DISABLE_EMAIL_CONFIRMATION=true